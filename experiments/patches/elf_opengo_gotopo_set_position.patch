diff --git a/src_cpp/elfgames/go/base/board.cc b/src_cpp/elfgames/go/base/board.cc
index 0872f81..1bf19eb 100644
--- a/src_cpp/elfgames/go/base/board.cc
+++ b/src_cpp/elfgames/go/base/board.cc
@@ -106,6 +106,101 @@ void clearBoard(Board* board) {
   board->_ply = 1;
 }
 
+bool SetRawPosition(
+    Board* board,
+    const std::string& boardstr,
+    Stone next_player) {
+  if (board == nullptr || boardstr.size() != NUM_INTERSECTION ||
+      (next_player != S_BLACK && next_player != S_WHITE)) {
+    return false;
+  }
+
+  clearBoard(board);
+  board->_next_player = next_player;
+  board->_simple_ko = M_PASS;
+  board->_simple_ko_color = S_EMPTY;
+  board->_ko_age = 1;
+
+  for (int row = 0; row < BOARD_SIZE; ++row) {
+    for (int x = 0; x < BOARD_SIZE; ++x) {
+      char ch = boardstr[row * BOARD_SIZE + x];
+      Stone s = S_EMPTY;
+      if (ch == 'B' || ch == 'X' || ch == 'b' || ch == 'x') {
+        s = S_BLACK;
+      } else if (ch == 'W' || ch == 'O' || ch == 'w' || ch == 'o') {
+        s = S_WHITE;
+      } else if (ch != '.') {
+        return false;
+      }
+      if (s == S_EMPTY) {
+        continue;
+      }
+      Coord c = OFFSETXY(x, BOARD_SIZE - 1 - row);
+      set_color(board, c, s);
+      board->_infos[c].id = 0;
+      board->_infos[c].next = 0;
+      board->_infos[c].last_placed = 1;
+    }
+  }
+
+  for (int y = 0; y < BOARD_SIZE; ++y) {
+    for (int x = 0; x < BOARD_SIZE; ++x) {
+      Coord start = OFFSETXY(x, y);
+      Stone color = board->_infos[start].color;
+      if (!HAS_STONE(color) || board->_infos[start].id != 0) {
+        continue;
+      }
+      if (board->_num_groups >= MAX_GROUP) {
+        return false;
+      }
+
+      unsigned short id = board->_num_groups++;
+      Group* group = &board->_groups[id];
+      group->color = color;
+      group->start = 0;
+      group->stones = 0;
+      group->liberties = 0;
+
+      Coord queue[NUM_INTERSECTION];
+      int head = 0;
+      int tail = 0;
+      bool seen_liberty[BOUND_COORD] = {};
+      queue[tail++] = start;
+      board->_infos[start].id = id;
+
+      while (head < tail) {
+        Coord c = queue[head++];
+        board->_infos[c].next = group->start;
+        group->start = c;
+        group->stones++;
+
+        FOR4(c, _, cc) {
+          Stone neighbor = board->_infos[cc].color;
+          if (neighbor == S_EMPTY) {
+            if (!seen_liberty[cc]) {
+              seen_liberty[cc] = true;
+              group->liberties++;
+            }
+          } else if (neighbor == color && board->_infos[cc].id == 0) {
+            board->_infos[cc].id = id;
+            if (tail >= NUM_INTERSECTION) {
+              return false;
+            }
+            queue[tail++] = cc;
+          }
+        }
+        ENDFOR4
+      }
+
+      if (group->stones <= 0 || group->liberties <= 0) {
+        return false;
+      }
+    }
+  }
+
+  return true;
+}
