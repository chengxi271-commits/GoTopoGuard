           "")) {}
 
+bool GoGameSelfPlay::setPosition(
+    const std::string& next_player,
+    const std::string& boardstr) {
+  Stone player = S_EMPTY;
+  if (next_player == "B" || next_player == "b" ||
+      next_player == "black" || next_player == "Black") {
+    player = S_BLACK;
+  } else if (
+      next_player == "W" || next_player == "w" ||
+      next_player == "white" || next_player == "White") {
+    player = S_WHITE;
+  } else {
+    return false;
+  }
+  return _state_ext.setRawPosition(boardstr, player);
+}
