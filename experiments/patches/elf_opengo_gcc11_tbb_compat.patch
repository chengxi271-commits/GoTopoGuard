diff --git a/src_cpp/elf/concurrency/TBBHashers.h b/src_cpp/elf/concurrency/TBBHashers.h
index 1e8506a..4696c1d 100644
--- a/src_cpp/elf/concurrency/TBBHashers.h
+++ b/src_cpp/elf/concurrency/TBBHashers.h
@@ -17,22 +17,21 @@
 
 #include <stdint.h>
 
-#include <thread>
-#include <typeindex>
+#include <functional>
 
 #include <tbb/concurrent_hash_map.h>
 
-namespace tbb {
-namespace interface5 {
+namespace elf {
 
-template <>
-inline size_t tbb_hasher<std::thread::id>(const std::thread::id& id) {
-  return std::hash<std::thread::id>()(id);
-}
+template <typename K>
+struct StdHashCompare {
+  static size_t hash(const K& key) { return std::hash<K>()(key); }
+  static bool equal(const K& a, const K& b) { return a == b; }
+};
 
-template <>
-inline size_t tbb_hasher<std::type_index>(const std::type_index& idx) {
-  return std::hash<std::type_index>()(idx);
-}
+// Compatibility note:
+// Current oneTBB headers no longer expose the old tbb::interface5::tbb_hasher
+// extension point. Callers that need non-integral keys now pass explicit
+// HashCompare types rather than specializing TBB internals.
 
-} // namespace interface5
-} // namespace tbb
+} // namespace elf
