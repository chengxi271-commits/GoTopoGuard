+void FullBoard::set_raw_position(const std::vector<std::string>& rows,
+                                 const int tomove) {
+    const int size = static_cast<int>(rows.size());
+    assert(size > 0 && size <= BOARD_SIZE);
+    reset_board(size);
+
+    for (int y = 0; y < size; y++) {
+        assert(static_cast<int>(rows[y].size()) == size);
+        for (int x = 0; x < size; x++) {
+            const auto vertex = get_vertex(x, size - 1 - y);
+            if (rows[y][x] == 'B' || rows[y][x] == 'X'
+                || rows[y][x] == 'b' || rows[y][x] == 'x') {
+                m_state[vertex] = BLACK;
+            } else if (rows[y][x] == 'W' || rows[y][x] == 'O'
+                       || rows[y][x] == 'w' || rows[y][x] == 'o') {
+                m_state[vertex] = WHITE;
+            } else {
+                m_state[vertex] = EMPTY;
+            }
+        }
+    }
+
+    m_prisoners[BLACK] = 0;
+    m_prisoners[WHITE] = 0;
+    m_empty_cnt = 0;
+    for (int i = 0; i < m_numvertices; i++) {
+        m_parent[i] = NUM_VERTICES;
+        m_next[i] = NUM_VERTICES;
+        m_libs[i] = 0;
+        m_stones[i] = 0;
+        m_neighbours[i] = 0;
+        if (m_state[i] == EMPTY) {
+            m_empty_idx[i] = m_empty_cnt;
+            m_empty[m_empty_cnt++] = i;
+        }
+    }
+
+    for (int y = 0; y < size; y++) {
+        for (int x = 0; x < size; x++) {
+            const auto vertex = get_vertex(x, y);
+            for (int k = 0; k < 4; k++) {
+                const auto neighbor = vertex + m_dirs[k];
+                const auto state = m_state[neighbor];
+                if (state == INVAL) {
+                    m_neighbours[vertex] += (1 << (NBR_SHIFT * BLACK));
+                    m_neighbours[vertex] += (1 << (NBR_SHIFT * WHITE));
+                    m_neighbours[vertex] += (1 << (NBR_SHIFT * EMPTY));
+                } else {
+                    m_neighbours[vertex] += (1 << (NBR_SHIFT * state));
+                }
+            }
+        }
+    }
+
+    for (int y = 0; y < size; y++) {
+        for (int x = 0; x < size; x++) {
+            const auto vertex = get_vertex(x, y);
+            if (m_state[vertex] == BLACK || m_state[vertex] == WHITE) {
+                m_parent[vertex] = vertex;
+                m_next[vertex] = vertex;
+                m_libs[vertex] = count_pliberties(vertex);
+                m_stones[vertex] = 1;
+            }
+        }
+    }
+
+    for (int y = 0; y < size; y++) {
+        for (int x = 0; x < size; x++) {
+            const auto vertex = get_vertex(x, y);
+            if (m_state[vertex] != BLACK && m_state[vertex] != WHITE) {
+                continue;
+            }
+            for (int k = 0; k < 4; k++) {
+                const auto neighbor = vertex + m_dirs[k];
+                if (m_state[neighbor] == m_state[vertex]
+                    && m_parent[neighbor] != m_parent[vertex]) {
+                    if (m_stones[m_parent[vertex]]
+                        >= m_stones[m_parent[neighbor]]) {
+                        merge_strings(m_parent[vertex], m_parent[neighbor]);
+                    } else {
+                        merge_strings(m_parent[neighbor], m_parent[vertex]);
+                    }
+                }
+            }
+        }
+    }
+
+    FastBoard::set_to_move(tomove);
+    m_hash = calc_hash(NO_VERTEX);
+    m_ko_hash = calc_ko_hash();
+}
