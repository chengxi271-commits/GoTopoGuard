+bool GameState::set_raw_position(const std::vector<std::string>& rows,
+                                 const int tomove) {
+    const int size = static_cast<int>(rows.size());
+    if (size <= 0 || size > BOARD_SIZE) {
+        return false;
+    }
+    for (const auto& row : rows) {
+        if (static_cast<int>(row.size()) != size) {
+            return false;
+        }
+        for (const auto ch : row) {
+            if (ch != 'B' && ch != 'W' && ch != 'X' && ch != 'O'
+                && ch != 'b' && ch != 'w' && ch != 'x' && ch != 'o'
+                && ch != '.') {
+                return false;
+            }
+        }
+    }
+    board.set_raw_position(rows, tomove);
+    m_movenum = 0;
+    m_passes = 0;
+    m_handicap = 0;
+    m_komove = FastBoard::NO_VERTEX;
+    m_lastmove = FastBoard::NO_VERTEX;
+    m_resigned = FastBoard::EMPTY;
+    anchor_ko_history();
+    anchor_game_history();
+    return true;
+}
